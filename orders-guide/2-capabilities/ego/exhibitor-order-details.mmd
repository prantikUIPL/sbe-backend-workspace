flowchart LR
    CAP(["Exhibitor Order Details"])
    EP_GET["GET /orders/:orderId<br/>(product-gated, nested by show)"]
    EP_INVL["GET /orders/:orderId/invoices<br/>(list)"]
    EP_INV["GET /orders/invoices/:id<br/>(download by invoice id)"]
    SVC["OrderDetailsService<br/>+ order-details.helpers"]
    ORDER["Order (company + product scoped findFirst)"]
    ONSITE["OnsiteBoothContact<br/>(per show)"]
    PM["PaymentMethod / Invoice"]
    DTO["OrderDetailsResponseDto<br/>(shows[] + unassigned)"]

    CAP -->|"exposes"| EP_GET
    CAP -->|"exposes"| EP_INVL
    CAP -->|"exposes"| EP_INV
    EP_GET -->|"handled by"| SVC
    SVC -->|"scoped read → 404"| ORDER
    SVC -->|"per-show join"| ONSITE
    SVC -->|"keyed lookup"| PM
    SVC -->|"returns"| DTO

    classDef ego fill:#ffe0b2,stroke:#e65100,stroke-width:3px,color:#000;
    classDef neighbor fill:#e3f2fd,stroke:#1565c0,color:#000;
    class CAP ego;
    class EP_GET,EP_INVL,EP_INV,SVC,ORDER,ONSITE,PM,DTO neighbor;
